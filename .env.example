# ==========================================
# DATABASE — MySQL / MariaDB (Hostinger)
# ==========================================
# hPanel -> Databases -> Management: create a database + user there,
# then copy the exact values shown on that page into the four lines below.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_yourdb
DB_USER=u123456789_youruser
DB_PASSWORD=

# Shared hosting caps concurrent MySQL connections. 10 is safe on every
# Hostinger plan; on a VPS / cloud server 20-50 handles heavy traffic.
DB_POOL_LIMIT=10

# Set to true ONLY if your MySQL host requires TLS (most Hostinger plans do not)
DB_SSL=false

# Optional: leave as 'local' unless your host needs a fixed offset (e.g. '+06:00')
DB_TIMEZONE=local

# ==========================================
# APPLICATION
# ==========================================
# The app reads the first .env it finds: the app folder (the one holding
# dist/), then the folder it was started from — so it is found even when the
# host starts the app from another folder. DOTENV_PATH=/full/path/.env forces
# one exact file. Variables set in the hosting panel always win over the file.
# Hostinger injects its own PORT — keep this unset there, or match the
# port shown in hPanel -> Website -> Node.js.
PORT=3000
# Where uploaded images are kept. Use an absolute path OUTSIDE the app folder,
# so uploading a new version of the app never deletes them.
# Empty = a folder next to the app called <app-folder>-uploads.
UPLOADS_DIR=
# Every uploaded image also keeps a copy in the database, so it can be restored
# if the images folder is ever lost. Set to off to keep images on disk only.
MEDIA_DB_BACKUP=on
# Your real website address. Used for the links inside password reset emails
# and texts, the bKash / Nagad / SSLCommerz return addresses AND (v3.12) the
# Google / Facebook sign-in return address, so it must be the https:// address
# customers open (no slash at the end).
APP_URL=https://your-domain.com
# Keep this as production on the live server. Since v3.10 `npm run build` and
# `npm start` ignore a leftover NODE_ENV=development here (it made the site slow).
NODE_ENV=production

# ==========================================
# SPEED CACHE (optional)
# ==========================================
# Busy pages are cached in memory out of the box. For very high traffic, or
# when the app runs on more than one server/process, point this at Redis
# (Hostinger VPS: apt install redis-server). If Redis is down the shop keeps
# working with the memory cache — Redis is never required.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PREFIX=pharma
# Memory cache size in MB (default 64)
# CACHE_MEMORY_MB=64

# ==========================================
# REPORTS (optional)
# ==========================================
# Sales Report / POS Sales Report count days in this time zone, whatever
# time zone the server or MySQL runs in (default Asia/Dhaka).
# REPORT_TIMEZONE=Asia/Dhaka

# ==========================================
# SECURITY (REQUIRED)
# ==========================================
# Signs admin/staff session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty a random secret is created per process, so every restart
# logs everyone out. Never leave this blank in production.
SESSION_SECRET=

# Dashboard login (owner).
# - First run: sign in with these. If both lines are left empty the login is
#   admin@nomail.com / password.
# - Change it right away from Dashboard -> Admin Account & Security (the
#   dashboard shows a warning while the default password still works).
# - Forgot the password? Put a NEW email + password pair here, restart the
#   app and sign in with it: the saved login is replaced and everyone else
#   signed in as the owner is signed out. A pair that was already used once
#   stops working after you change the password from the dashboard.
# - "Could not sign in" usually means the database is not reachable:
#   open https://your-domain.com/api/health to see the database status.
# - A password with spaces may be wrapped in quotes: ADMIN_PASSWORD="my pass 1".
#   A # inside a value is kept (abc#123), a comment needs a space before #.
ADMIN_EMAIL=admin@nomail.com
ADMIN_PASSWORD=password

# ==========================================
# ONLINE PAYMENTS
# ==========================================
# bKash, Nagad and SSLCommerz credentials are entered in the dashboard:
# System Configuration -> Payments. Nothing is needed here.

# ==========================================
# LICENSE SERVER (required — the dashboard and POS stay locked until a
# license is activated from Dashboard -> License. The website and its
# checkout always keep working for customers.)
# ==========================================
# Your License Server's address (https only)
LICENSE_SERVER_URL=https://your-license-server.com
# The slug of this eCommerce/POS product on the License Server (Products page).
# Several slugs (aliases) may be listed comma-separated; the first is sent.
LICENSE_PRODUCT_SLUG=
# From GET https://your-license-server.com/api/v2/license/public-key:
# "publicKey" (32 bytes, base64) and "keyId". Recommended. If left empty the
# key is downloaded once on the first activation and pinned.
# NEVER put the License Server's PRIVATE signing key here or anywhere else.
LICENSE_PUBLIC_KEY=
LICENSE_KEY_ID=
# Expected product type in the token (default ecommerce_pos). Empty = don't check.
# LICENSE_PRODUCT_TYPE=ecommerce_pos
# Shown on the License page
LICENSE_SUPPORT_NAME=
LICENSE_SUPPORT_EMAIL=
LICENSE_SUPPORT_PHONE=
LICENSE_SUPPORT_URL=
# Optional tuning: request timeout (ms) and minimum gap between "Check now" clicks (s)
# LICENSE_HTTP_TIMEOUT_MS=15000
# LICENSE_SYNC_COOLDOWN_SECONDS=60

# v3.9 — Products → Import downloads pictures only from public websites. Set to 1
# only when two shops on the same private network / VPS import from each other
# by a local IP address.
# PRODUCT_IMPORT_ALLOW_PRIVATE=0

# ==========================================
# v3.11 — COURIERS & SMS
# ==========================================
# Steadfast, Pathao, RedX and Carrybee keys are entered in the dashboard:
# System Configuration -> Integrations. MiM SMS (and the other SMS gateways) in
# Dashboard -> SMS. Nothing is needed here.
