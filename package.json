{
  "name": "ecommerce-pos",
  "private": true,
  "version": "3.15.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:responsive": "node scripts/responsive-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "html2canvas-pro": "^1.6.7",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.12",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "redis": "^4.7.1",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "description": "Topper IT e-commerce storefront + POS + admin dashboard (React 19 + Express + MySQL/MariaDB)",
  "engines": {
    "node": ">=20.19"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
